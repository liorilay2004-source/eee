# Copy to .dev.vars for `wrangler dev` (that file is git-ignored). NEVER commit real values.
# In the cloud set them with `wrangler secret put <NAME>`.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Random string, at least 32 characters: salts the hash of client addresses in rate limiting.
RATE_LIMIT_SALT=

# OPTIONAL live fare sources (src/quotes.ts). Leave a value empty and that source is simply not used and costs nothing.
# Create each vendor account on its FREE plan and NEVER add a payment card: the code stops before the free allowance
# (caps are in src/sources/, needs migration 0004), but the account must not be able to charge anything anyway.
IGNAV_API_KEY=
WEGO_API_TOKEN=
SEARCHAPI_KEY=
SERPAPI_KEY=

# OPTIONAL price alerts (src/telegram.ts), the free Telegram Bot API. All three or the channel stays off.
# TELEGRAM_WEBHOOK_SECRET: 16-256 characters of A-Z a-z 0-9 _ - (Telegram's rule for secret_token).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# OPTIONAL private-use lock (src/access.ts). Empty = the API is public. 20-256 visible ASCII characters without spaces =
# every API call needs "Authorization: Bearer <key>" (the web asks for it once per browser). Shorter = misconfigured:
# the API then fails closed (503). Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_KEY=
